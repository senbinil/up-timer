#!/bin/bash -e

# Auto-generate secret_key_base if not explicitly set via env var
if [ -z "$SECRET_KEY_BASE" ]; then
  export SECRET_KEY_BASE=$(openssl rand -hex 64)
  echo "Generated SECRET_KEY_BASE for this session"
fi

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
fi

# Opt in to the ZJIT compiler when ZJIT_ENABLE is set (see bin/zjit-env.sh).
# Applied after db:prepare so migrations run on the stock interpreter.
. "$(cd "$(dirname "$0")" && pwd)/zjit-env.sh"

exec "${@}"
