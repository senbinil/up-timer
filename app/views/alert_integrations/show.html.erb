<div class="space-y-6">
  <%# ── Header ── %>
  <div class="space-y-2">
    <h1 class="text-2xl md:text-[32px] font-semibold leading-10 tracking-[-0.01em] text-navy font-[Hanken_Grotesk]">Alert Integrations</h1>
    <p class="text-sm text-slate-400 max-w-2xl">Configure system notification endpoints, manage recipient groups, and define specific trigger conditions for automated fleet responses.</p>
  </div>

  <%# ═══════════════════════════════════════
     Alert Triggers Grid
     ═══════════════════════════════════════ %>
  <div class="card space-y-4">
    <div>
      <h2 class="text-base font-semibold text-primary-container font-[Hanken_Grotesk]">Alert Triggers</h2>
      <p class="text-xs text-slate-400 mt-0.5">Define conditions that initiate notification sequences.</p>
    </div>

    <hr class="border-divider" />

    <div class="space-y-2">
      <%= render "triggers_list" %>
    </div>
  </div>

  <%# ═══════════════════════════════════════
     Email Recipients Table
     ═══════════════════════════════════════ %>
  <div class="card space-y-4">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-base font-semibold text-primary-container font-[Hanken_Grotesk]">Email Recipients</h2>
        <p class="text-xs text-slate-400 mt-0.5">Manage active distribution lists for system alerts.</p>
      </div>
    </div>

    <hr class="border-divider" />

    <%# Add Recipient Search Form %>
    <div class="flex items-center gap-3">
      <%= form_with model: @new_recipient, url: recipients_alert_integrations_path, class: "flex gap-2 flex-1", data: { controller: "recipient-search", turbo_frame: "recipients_list" } do |f| %>
        <div class="relative flex-1 max-w-sm">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>
          </span>
          <%= f.email_field :email, placeholder: "Search or add email...", class: "input-field pl-10", data: { recipient_search_target: "input", action: "input->recipient-search#search" } %>
        </div>
        <%= f.button class: "btn btn-primary text-xs flex-shrink-0" do %>Add Recipient<% end %>
      <% end %>
    </div>

    <%# Recipients Table %>
    <div class="overflow-x-auto">
      <%= render "recipients_list" %>
    </div>
  </div>
</div>
