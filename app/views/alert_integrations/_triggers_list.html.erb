<%= turbo_frame_tag "triggers_list" do %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 items-stretch">
    <% @triggers.each do |trigger| %>
      <div class="relative flex flex-col gap-3 p-3 border border-border rounded-default hover:border-primary-container transition-colors h-full">
        <div class="flex items-start gap-3">
          <% dot_color = case trigger.severity
               when "critical" then "bg-error"
               when "warning" then "bg-warning"
               when "maintenance" then "bg-success"
               else "bg-primary-container"
             end %>
          <span class="w-2 h-2 rounded-full <%= dot_color %> flex-shrink-0 mt-2"></span>

          <div class="flex-1 min-w-0">
            <h3 class="text-sm font-semibold text-navy"><%= trigger.name %></h3>
            <p class="text-xs text-slate-400 leading-relaxed mt-1"><%= trigger.description %></p>

            <% if current_account&.admin? && (log = trigger.last_action_log) %>
              <p class="text-[10px] text-slate-400 font-mono mt-2">
                <%= log.action.to_s.humanize %> by <%= log.account&.email || "system" %> <%= time_ago_in_words(log.created_at) %> ago
              </p>
            <% end %>
          </div>
        </div>

        <div class="flex items-center gap-3 mt-auto pt-2 border-t border-border">
          <%= button_to toggle_trigger_email_alert_integrations_path(trigger), method: :post, form: { data: { turbo_frame: "triggers_list" } }, class: "flex items-center gap-2 group" do %>
            <div class="relative w-9 h-5 rounded-full transition-colors <%= trigger.email_notify? ? 'bg-primary-container' : 'bg-border' %>">
              <div class="absolute top-0.5 w-4 h-4 rounded-full bg-white shadow-sm transition-transform <%= trigger.email_notify? ? 'translate-x-4' : 'translate-x-0.5' %>"></div>
            </div>
            <span class="text-[10px] text-slate-400 font-mono group-hover:text-navy transition-colors"><%= trigger.email_notify? ? 'Email on' : 'Email off' %></span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <% if @triggers.none? %>
    <p class="text-xs text-slate-400 py-8 text-center">No triggers configured.</p>
  <% end %>
<% end %>
