<%= turbo_frame_tag "recipients_list" do %>
  <table class="w-full text-sm" aria-label="Email Recipients">
    <thead>
      <tr class="border-b border-border">
        <th class="text-left text-[10px] font-semibold uppercase tracking-[0.05em] text-slate-400 font-mono py-2 px-3">Recipient</th>
        <th class="text-left text-[10px] font-semibold uppercase tracking-[0.05em] text-slate-400 font-mono py-2 px-3 hidden sm:table-cell">Role</th>
        <th class="text-center text-[10px] font-semibold uppercase tracking-[0.05em] text-slate-400 font-mono py-2 px-3 w-20">Active</th>
      </tr>
    </thead>
    <tbody>
      <% @recipients.each do |recipient| %>
        <tr class="border-b border-border last:border-0 hover:bg-surface-container-low transition-colors">
          <td class="py-2.5 px-3">
            <div class="flex items-center gap-3">
              <div class="w-7 h-7 rounded-default bg-surface-container-high flex items-center justify-center flex-shrink-0 text-slate-400">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
              </div>
              <span class="text-sm font-medium text-navy truncate"><%= recipient.email %></span>
            </div>
          </td>
          <td class="py-2.5 px-3 hidden sm:table-cell">
            <span class="text-xs text-slate-400"><%= recipient.role.presence || recipient.name.presence || "Recipient" %></span>
          </td>
          <td class="py-2.5 px-3 text-center">
            <%= button_to toggle_recipient_alert_integrations_path(recipient), method: :post, form: { data: { turbo_frame: "recipients_list" } }, class: "inline-flex" do %>
              <% if recipient.active? %>
                <div class="w-5 h-5 rounded bg-primary-container flex items-center justify-center">
                  <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                </div>
              <% else %>
                <div class="w-5 h-5 rounded border-2 border-border"></div>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if @recipients.none? %>
    <p class="text-xs text-slate-400 py-6 text-center">No recipients configured.</p>
  <% end %>
<% end %>
