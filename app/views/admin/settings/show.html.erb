<div class="max-w-lg mx-auto space-y-6">
  <div class="space-y-2">
    <p class="text-xs font-semibold uppercase tracking-[0.05em] text-slate-400 font-mono">Admin</p>
    <h1 class="text-2xl font-semibold text-navy font-[Hanken_Grotesk]">Site Settings</h1>
    <p class="text-sm text-slate-400">Manage feature flags and system-wide settings.</p>
  </div>

  <%= render "admin/settings/registration_card" %>

  <div class="card">
    <div class="space-y-4">
      <h2 class="text-lg font-semibold text-navy">Activity Log</h2>
      <% if @action_logs.any? %>
        <div class="divide-y divide-divider">
          <% @action_logs.each do |log| %>
            <div class="flex items-start gap-3 py-3 first:pt-0 last:pb-0">
              <div class="mt-0.5">
                <span class="inline-flex items-center justify-center w-6 h-6 rounded-full <%= log.metadata['registration_enabled'] ? 'bg-success-container text-success' : 'bg-error-container text-error' %>">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182" />
                  </svg>
                </span>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm text-navy">
                  <span class="font-medium"><%= log.account&.email || "System" %></span>
                  <span class="text-slate-400">changed registration to</span>
                  <span class="font-medium <%= log.metadata['registration_enabled'] ? 'text-success' : 'text-error' %>"><%= log.metadata['registration_enabled'] ? 'enabled' : 'disabled' %></span>
                </p>
                <p class="text-xs text-slate-400 mt-0.5 font-mono"><%= log.created_at.strftime("%b %d, %Y %H:%M") %></p>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-xs text-slate-400">No changes recorded yet.</p>
      <% end %>
    </div>
  </div>
</div>
